<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash: black with the HAVEN mark, held only until the saved theme is read. -->
    <style name="Theme.Haven.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/haven_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Haven</item>
    </style>

    <style name="Theme.Haven" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/haven_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
